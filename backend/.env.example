# Supabase Project Configuration
SUPABASE_URL=https://your-project.supabase.co
# Use your publishable anon key (or service_role key for backend admin operations)
SUPABASE_KEY=your-supabase-key

# Optional: If your frontend is running on a different port
FRONTEND_URL=http://localhost:3000

# Audio practice. Transcription credentials stay on this server.
APP_ENV=development
PRACTICE_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Explicit development fixture mode: set provider=mock AND allow=true.
PRACTICE_ALLOW_MOCK=false
# Practice APIs use a PUBLIC key + the signed-in user token, never a service key.
# Existing frontend/.env.local public values are loaded automatically.
SUPABASE_ANON_KEY=
